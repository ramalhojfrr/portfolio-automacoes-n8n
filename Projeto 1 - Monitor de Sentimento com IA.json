          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "Você é um analista de atendimento ao cliente. Analise o texto recebido e responda obrigatoriamente em formato JSON puro, sem blocos de código markdown nem crases, contendo exatamente estas chaves: {\"sentimento\": \"Positivo\" | \"Neutro\" | \"Negativo\", \"resumo\": \"síntese analítica de uma única frase\", \"urgente\": true | false}. O campo sentimento deve ser estritamente um dos três valores.",
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
      "id": "130e3793-18cf-4b0b-9779-6b01f84bcff4",
      "name": "Analisar Sentimento (IA)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        224,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst origem = $('Webhook').all();\nconst processedItems = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const body = (origem[i] && origem[i].json.body) || {};\n  const base = {\n    cliente: body.cliente || '',\n    canal: body.canal || '',\n    comentario: body.comentario || '',\n  };\n  try {\n    let ai = item.json.output && item.json.output[0] && item.json.output[0].content && item.json.output[0].content[0]\n      ? item.json.output[0].content[0].text\n      : (item.json.text || (item.json.message && item.json.message.content));\n\n    if (typeof ai === 'string') {\n      ai = ai.replace(/\\x60\\x60\\x60(json)?/gi, '').trim();\n      ai = JSON.parse(ai);\n    }\n    if (!ai || typeof ai !== 'object') throw new Error('Resposta da IA vazia ou inválida');\n\n    const validos = ['Positivo', 'Neutro', 'Negativo'];\n    const sentimento = validos.includes(ai.sentimento) ? ai.sentimento : 'Desconhecido';\n    const urgente = ai.urgente === true || ai.urgente === 'true';\n\n    let nivelAlerta;\n    if (sentimento === 'Negativo' && urgente) {\n      nivelAlerta = 'CRÍTICO - Requer ação imediata';\n    } else if (sentimento === 'Negativo') {\n      nivelAlerta = 'Alto';\n    } else if (urgente) {\n      nivelAlerta = 'Médio';\n    } else if (sentimento === 'Neutro') {\n      nivelAlerta = 'Baixo';\n    } else if (sentimento === 'Positivo') {\n      nivelAlerta = 'Nenhum';\n    } else {\n      nivelAlerta = 'Revisar manualmente';\n    }\n\n    processedItems.push({\n      json: {\n        ...base,\n        sentimento,\n        resumo: ai.resumo || '',\n        urgente,\n        nivelAlerta,\n        processadoEm: new Date().toISOString(),\n        erroDetalhe: '',\n      },\n    });\n  } catch (error) {\n    processedItems.push({\n      json: {\n        ...base,\n        sentimento: 'Desconhecido',\n        resumo: 'Erro ao processar resposta da IA',\n        urgente: false,\n        nivelAlerta: 'Erro',\n        processadoEm: new Date().toISOString(),\n        erroDetalhe: error.message,\n      },\n    });\n  }\n}\n\nreturn processedItems;"
      },
